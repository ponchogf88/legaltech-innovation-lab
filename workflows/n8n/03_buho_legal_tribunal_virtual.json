        ]
      ]
    },
    "4. Llenador de Promociones y Formularios": {
      "main": [
        [
          {
            "node": "5. Aprobacion Abogado (Filtro Humano)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5. Aprobacion Abogado (Filtro Humano)": {
      "main": [
        [
          {
